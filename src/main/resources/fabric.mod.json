{
  "schemaVersion": 1,
  "id": "afk-to-ghost",
  "version": "${version}",
  "name": "AFK to Ghost",
  "description": "Turns AFK players into safe, invisible ghosts.",
  "authors": ["alex"],
  "license": "MIT",
  "icon": "assets/afk-to-ghost/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "dev.alex.afktoghost.AfkToGhostMod"
      }
    ],
    "modmenu": [
      {
        "adapter": "kotlin",
        "value": "dev.alex.afktoghost.client.AfkToGhostModMenu"
      }
    ]
  },
  "mixins": [
    "afk-to-ghost.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.11",
    "fabric-api": ">=0.92.2+1.20.1",
    "fabric-language-kotlin": ">=1.10.19+kotlin.1.9.23",
    "minecraft": "1.20.1",
    "java": ">=17"
  },
  "suggests": {
    "modmenu": "*",
    "cloth-config": "*"
  }
}
