{
  "schemaVersion": 1,
  "id": "afk-to-ghost",
  "version": "${version}",
  "name": "AFK to Ghost",
  "description": "Turns AFK players into safe, invisible ghosts.",
  "authors": ["alex"],
  "license": "MIT",
  "icon": "assets/afk-to-ghost/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "dev.alex.afktoghost.AfkToGhostMod"
      }
    ],
    "modmenu": [
      {
        "adapter": "kotlin",
        "value": "dev.alex.afktoghost.client.AfkToGhostModMenu"
      }
    ]
  },
  "mixins": [
    "afk-to-ghost.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.18.6",
    "fabric-api": ">=0.151.0+26.1.2",
    "fabric-language-kotlin": ">=1.13.12+kotlin.2.4.0",
    "minecraft": "26.1.2"
  },
  "suggests": {
    "modmenu": "*",
    "cloth-config": "*"
  }
}
